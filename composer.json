{
	"name": "artemsk/veer-core",
	"description": "The Veer Engine Core.",
	"keywords": ["cms", "veer", "laravel-based"],
	"license": "MIT",
	"type": "package",
	"require": {
        "php": ">=5.5.9",
        "laravel/framework": "11.*",
		"doctrine/dbal": "*",
		"guzzlehttp/guzzle": "*",
		"predis/predis": "*",
		"intervention/image": "*",
		"artemsk/imagecache": "*"
	},
	"require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "*",
        "phpspec/phpspec": "*",
        "artemsk/veer": "@dev",
		"rector/rector": "*",
		"driftingly/rector-laravel": "*"
    },
	"autoload": {
		"files": [
			"src/Veer/helpers.php"
		],		
		"psr-4": {
			"Veer\\": "src/Veer/"
		}
	},
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
	"repositories" : [
		{
			"type": "git",
			"url": "https://github.com/artemsk/imagecache.git"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"preferred-install": "dist",
		"allow-plugins": {
			"kylekatarnls/update-helper": true
		}
	}
}
